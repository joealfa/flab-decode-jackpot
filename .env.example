# Fortune Lab Environment Configuration
# Copy this file to .env and customize as needed

# Flask Configuration
DEBUG=False
SECRET_KEY=
HOST=127.0.0.1
PORT=5080
TESTING=False
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=
SSL_CERTFILE=
SSL_KEYFILE=

# Data Paths (relative to project root)
DATA_PATH=app/data
ANALYSIS_PATH=app/data/analysis
AI_ANALYSIS_PATH=app/data/ai_analysis
PROGRESS_PATH=app/data/progress
ACCURACY_PATH=app/data/accuracy

# Scraper Configuration
HEADLESS=True
PCSO_URL=https://www.pcso.gov.ph/SearchLottoResult.aspx
PAGE_TIMEOUT=30

# Progress Tracking
# Seconds to keep finished scrape progress files (cleanup runs at startup and every minute)
PROGRESS_CLEANUP_AGE=180

# Logging Configuration
LOG_LEVEL=INFO

# Analysis Configuration
DEFAULT_PREDICTION_COUNT=5

# Default Date Range

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_SCRAPE=10 per hour
RATE_LIMIT_ANALYZE=100 per hour
RATE_LIMIT_GENERAL=200 per hour
RATE_LIMIT_STORAGE_URI=memory://
MAX_CONCURRENT_SCRAPES=1

# AI Configuration (Ollama)
OLLAMA_ENABLED=True
OLLAMA_MODEL=llama3.1:8b
OLLAMA_HOST=http://localhost:11434
OLLAMA_TIMEOUT=300

# Feature Flags
